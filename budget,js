// budget.js

const reportId = new URLSearchParams(window.location.search).get('report_id');

if (!reportId) {
  alert('Kein Bericht ausgewählt. Bitte über die Startseite öffnen.');
  window.location.href = 'index.html';
}

console.log('DEBUG budget.js reportId:', reportId);

let budgets = [];
let isLoading = false;
let editingYearMonth = null;

const monthNames = {
  '01': 'Januar', '02': 'Februar', '03': 'März', '04': 'April',
  '05': 'Mai', '06': 'Juni', '07': 'Juli', '08': 'August',
  '09': 'September', '10': 'Oktober', '11': 'November', '12': 'Dezember'
};

// ===== DOM READY =====

document.addEventListener('DOMContentLoaded', function() {
  console.log('DEBUG DOM ready');

  const now = new Date();
  document.getElementById('budgetYear').value = now.getFullYear();
  document.getElementById('budgetMonth').value = String(now.getMonth() + 1).padStart(2, '0');

  document.getElementById('addBudgetBtn').onclick = function() { addBudget(); };
  document.getElementById('resetBtn').onclick = function() { clearForm(); };
  document.getElementById('saveBtn').onclick = function() { saveEdit(); };
  document.getElementById('cancelBtn').onclick = function() { closeModal(); };
  document.getElementById('backBtn').onclick = function() {
    console.log('DEBUG backBtn clicked');
    window.location.href = 'report.html?report_id=' + reportId;
  };

  loadBudgets();
});

// ===== LOAD BUDGETS =====

async function loadBudgets() {
  isLoading = true;

  try {
    const { data, error } = await db
      .from('budget_history')
      .select('*')
      .eq('report_id', reportId)
      .order('year_month', { ascending: false });

    if (error) {
      console.error('Fehler beim Laden:', error);
      alert('Fehler beim Laden: ' + error.message);
      isLoading = false;
      return;
    }

    console.log('DEBUG loadBudgets:', data);
    budgets = data || [];
    renderTable();
    isLoading = false;
  } catch (err) {
    console.error('Fehler beim Laden (catch):', err);
    alert('Fehler beim Laden: ' + err.message);
    isLoading = false;
  }
}

// ===== ADD BUDGET =====

async function addBudget() {
  console.log('DEBUG addBudget called');

  const year = document.getElementById('budgetYear').value;
  const month = document.getElementById('budgetMonth').value;
  const amountRaw = document.getElementById('budgetAmount').value;
  const amount = parseFloat(amountRaw);

  console.log('DEBUG year:', year, 'month:', month, 'amount:', amount);

  if (!year || !month || amountRaw === '' || isNaN(amount) || amount < 0) {
    alert('Bitte alle Felder ausfüllen und einen gültigen Betrag eingeben.');
    return;
  }

  const yearMonth = `${year}-${month}`;
  const exists = budgets.find(b => b.year_month === yearMonth);

  if (exists) {
    if (!confirm('Für diesen Monat existiert bereits ein Budget. Überschreiben?')) {
      return;
    }
  }

  if (isLoading) {
    console.log('DEBUG isLoading true, aborted');
    return;
  }

  isLoading = true;
  document.getElementById('addBudgetBtn').disabled = true;

  const row = {
    report_id: reportId,
    year_month: yearMonth,
    budget_amount: amount
  };

  console.log('DEBUG addBudget row:', row);

  try {
    const { data, error } = await db
      .from('budget_history')
      .upsert(row, { onConflict: 'report_id,year_month' })
      .select('*');

    if (error) {
      console.error('Fehler beim Speichern:', error);
      alert('Fehler beim Speichern: ' + error.message);
      isLoading = false;
      document.getElementById('addBudgetBtn').disabled = false;
      return;
    }

    console.log('DEBUG addBudget result:', data);
    clearForm();
    await loadBudgets();
    document.getElementById('addBudgetBtn').disabled = false;
  } catch (err) {
    console.error('Fehler beim Speichern (catch):', err);
    alert('Fehler beim Speichern: ' + err.message);
    isLoading = false;
    document.getElementById('addBudgetBtn').disabled = false;
  }
}

// ===== EDIT BUDGET =====

function openEditModal(yearMonth) {
  const budget = budgets.find(b => b.year_month === yearMonth);
  if (!budget) return;

  editingYearMonth = yearMonth;
  document.getElementById('editBudgetAmount').value = budget.budget_amount;
  document.getElementById('editModal').classList.add('active');
}

function closeModal() {
  document.getElementById('editModal').classList.remove('active');
  editingYearMonth = null;
}

async function saveEdit() {
  if (!editingYearMonth) return;

  const amount = parseFloat(document.getElementById('editBudgetAmount').value);

  if (isNaN(amount) || amount < 0) {
    alert('Bitte einen gültigen Betrag eingeben.');
    return;
  }

  if (isLoading) return;
  isLoading = true;

  console.log('DEBUG saveEdit yearMonth:', editingYearMonth, 'amount:', amount);

  try {
    const { data, error } = await db
      .from('budget_history')
      .update({ budget_amount: amount })
      .eq('report_id', reportId)
      .eq('year_month', editingYearMonth)
      .select('*');

    if (error) {
      console.error('Fehler beim Aktualisieren:', error);
      alert('Fehler beim Aktualisieren: ' + error.message);
      isLoading = false;
      return;
    }

    console.log('DEBUG saveEdit updated:', data);
    closeModal();
    await loadBudgets();
  } catch (err) {
    console.error('Fehler beim Aktualisieren (catch):', err);
    alert('Fehler beim Aktualisieren: ' + err.message);
    isLoading = false;
  }
}

// ===== DELETE BUDGET =====

async function deleteBudget(yearMonth) {
  if (isLoading) return;
  if (!confirm('Wirklich löschen?')) return;

  isLoading = true;
  console.log('DEBUG deleteBudget:', yearMonth);

  try {
    const { error } = await db
      .from('budget_history')
      .delete()
      .eq('report_id', reportId)
      .eq('year_month', yearMonth);

    if (error) {
      console.error('Fehler beim Löschen:', error);
      alert('Fehler beim Löschen: ' + error.message);
      isLoading = false;
      return;
    }

    await loadBudgets();
  } catch (err) {
    console.error('Fehler beim Löschen (catch):', err);
    alert('Fehler beim Löschen: ' + err.message);
    isLoading = false;
  }
}

// ===== RENDER TABLE =====

function renderTable() {
  const tbody = document.getElementById('budgetTable');

  if (!budgets || budgets.length === 0) {
    tbody.innerHTML = '<tr class="empty-state"><td colspan="4">Keine Budgets vorhanden.</td></tr>';
    return;
  }

  tbody.innerHTML = budgets.map(budget => {
    const parts = budget.year_month.split('-');
    const year = parts[0];
    const month = parts[1];
    const monthName = monthNames[month] || month;

    return `
      <tr>
        <td>${year}</td>
        <td>${monthName}</td>
        <td class="text-right"><strong>${formatCurrency(budget.budget_amount)}</strong></td>
        <td class="text-right action-buttons">
          <button class="icon-btn icon-delete" onclick="deleteBudget('${budget.year_month}')" title="Löschen">✕</button>
          <button class="icon-btn icon-edit" onclick="openEditModal('${budget.year_month}')" title="Bearbeiten">✎</button>
        </td>
      </tr>
    `;
  }).join('');
}

// ===== HELPERS =====

function formatCurrency(value) {
  return new Intl.NumberFormat('de-DE', {
    style: 'currency',
    currency: 'EUR'
  }).format(value);
}

function clearForm() {
  const now = new Date();
  document.getElementById('budgetYear').value = now.getFullYear();
  document.getElementById('budgetMonth').value = String(now.getMonth() + 1).padStart(2, '0');
  document.getElementById('budgetAmount').value = '';
}

// ===== GLOBAL =====

window.deleteBudget = deleteBudget;
window.openEditModal = openEditModal;
