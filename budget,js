// ===== LOAD BUDGETS =====

async function loadBudgets() {
  isLoading = true;

  try {
    const { data, error } = await db
      .from('budget_history')
      .select('*')
      .eq('report_id', reportId)
      .order('year_month', { ascending: false });

    if (error) {
      console.error('Fehler beim Laden:', error);
      alert('Fehler beim Laden der Budgets: ' + error.message);
      isLoading = false;
      return;
    }

    console.log('DEBUG loadBudgets rows:', data);

    budgets = data || [];
    renderTable();
    isLoading = false;
  } catch (error) {
    console.error('Fehler beim Laden (catch):', error);
    alert('Fehler beim Laden der Budgets: ' + error.message);
    isLoading = false;
  }
}

// ===== ADD BUDGET =====

async function addBudget(event) {
  if (event) event.preventDefault();
  console.log('DEBUG addBudget clicked');

  const year = document.getElementById('budgetYear').value;
  const month = document.getElementById('budgetMonth').value;
  const amount = parseFloat(document.getElementById('budgetAmount').value);

  if (!year || !month || isNaN(amount) || amount < 0) {
    alert('Bitte alle Felder ausfüllen und einen gültigen Betrag eingeben.');
    return;
  }

  const yearMonth = `${year}-${month}`;

  const exists = budgets.find(b => b.year_month === yearMonth);
  if (exists) {
    if (!confirm('Für diesen Monat existiert bereits ein Budget. Überschreiben?')) {
      return;
    }
  }

  if (isLoading) return;
  isLoading = true;
  document.getElementById('addBudgetBtn').disabled = true;

  const row = {
    report_id: reportId,
    year_month: yearMonth,
    budget_amount: amount
  };

  console.log('DEBUG addBudget row to insert/upsert:', row);

  try {
    const { data, error } = await db
      .from('budget_history')
      .upsert(row, { onConflict: 'report_id,year_month' })
      .select('*');

    if (error) {
      console.error('Fehler beim Speichern:', error);
      alert('Fehler beim Speichern des Budgets: ' + error.message);
      isLoading = false;
      document.getElementById('addBudgetBtn').disabled = false;
      return;
    }

    console.log('DEBUG addBudget upsert result:', data);

    clearForm();
    await loadBudgets();
  } catch (error) {
    console.error('Fehler beim Speichern (catch):', error);
    alert('Fehler beim Speichern des Budgets: ' + error.message);
    isLoading = false;
    document.getElementById('addBudgetBtn').disabled = false;
  }
}

// ===== EDIT BUDGET =====

function openEditModal(yearMonth) {
  const budget = budgets.find(b => b.year_month === yearMonth);
  if (!budget) return;

  editingYearMonth = yearMonth;
  document.getElementById('editBudgetAmount').value = budget.budget_amount;
  document.getElementById('editModal').classList.add('active');
}

