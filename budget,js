// budget.js

const reportId = new URLSearchParams(window.location.search).get('report_id');

if (!reportId) {
  alert('Kein Bericht ausgewählt. Bitte über die Startseite öffnen.');
  window.location.href = '/index.html';
}

let budgets = [];
let isLoading = false;
let editingYearMonth = null;

const monthNames = {
  '01': 'Januar', '02': 'Februar', '03': 'März', '04': 'April',
  '05': 'Mai', '06': 'Juni', '07': 'Juli', '08': 'August',
  '09': 'September', '10': 'Oktober', '11': 'November', '12': 'Dezember'
};

window.addEventListener('DOMContentLoaded', () => {
  // Hard fail, falls supabase.js kein "db" bereitstellt
  if (typeof db === 'undefined') {
    alert('Supabase ist nicht initialisiert (db ist undefined). Prüfe supabase.js Einbindung.');
    return;
  }

  // Defaults: aktueller Monat/Jahr
  const now = new Date();
  setYearMonth(String(now.getFullYear()), String(now.getMonth() + 1).padStart(2, '0'));

  // Buttons wie bei categories.js: addEventListener + href
  document.getElementById('backBtn').addEventListener('click', () => {
    window.location.href = `/report.html?report_id=${reportId}`;
  });

  document.getElementById('addBudgetBtn').addEventListener('click', addBudget);
  document.getElementById('resetBtn').addEventListener('click', clearForm);

  document.getElementById('saveBtn').addEventListener('click', saveEdit);
  document.getElementById('cancelBtn').addEventListener('click', closeModal);

  loadBudgets();
});

function setYearMonth(year, month) {
  const yearEl = document.getElementById('budgetYear');
  const monthEl = document.getElementById('budgetMonth');
  if (yearEl) yearEl.value = year;
  if (monthEl) monthEl.value = month;
}

async function loadBudgets() {
  isLoading = true;
  try {
    const { data, error } = await db
      .from('budget_history')
      .select('*')
      .eq('report_id', reportId)
      .order('year_month', { ascending: false });

    if (error) throw error;

    budgets = data || [];
    renderTable();
  } catch (err) {
    console.error('Fehler beim Laden der Budgets:', err);
    alert('Fehler beim Laden der Budgets: ' + (err?.message || err));
  } finally {
    isLoading = false;
  }
}

async function addBudget(event) {
  if (event) event.preventDefault();
  if (isLoading) return;

  const year = document.getElementById('budgetYear').value;
  const month = document.getElementById('budgetMonth').value;
  const amountRaw = document.getElementById('budgetAmount').value;
  const amount = parseFloat(amountRaw);

  if (!year || !month || amountRaw === '' || Number.isNaN(amount) || amount < 0) {
    alert('Bitte Jahr, Monat und ein gültiges Budget eingeben.');
    return;
  }

  const yearMonth = `${year}-${month}`;

  const exists = budgets.some(b => b.year_month === yearMonth);
  if (exists) {
    const ok = confirm('Für diesen Monat existiert bereits ein Budget. Überschreiben?');
    if (!ok) return;
  }

  isLoading = true;
  document.getElementById('addBudgetBtn').disabled = true;

  try {
    const row = {
      report_id: reportId,
      year_month: yearMonth,
      budget_amount: amount
    };

    // Upsert: Monat anlegen oder überschreiben
    const { error } = await db
      .from('budget_history')
      .upsert(row, { onConflict: 'report_id,year_month' });

    if (error) throw error;

    clearForm();
    await loadBudgets();
  } catch (err) {
    console.error('Fehler beim Speichern des Budgets:', err);
    alert('Fehler beim Speichern des Budgets: ' + (err?.message || err));
  } finally {
    isLoading = false;
    document.getElementById('addBudgetBtn').disabled = false;
  }
}

function renderTable() {
  const tbody = document.getElementById('budgetTable');

  if (!budgets || budgets.length === 0) {
    tbody.innerHTML = '<tr class="empty-state"><td colspan="4">Keine Budgets vorhanden.</td></tr>';
    return;
  }

  tbody.innerHTML = budgets.map(b => {
    const [year, month] = String(b.year_month).split('-');
    const monthName = monthNames[month] || month;

    return `
      <tr>
        <td>${year}</td>
        <td>${monthName}</td>
        <td class="text-right"><strong>${formatCurrency(b.budget_amount || 0)}</strong></td>
        <td class="text-right action-buttons">
          <button class="icon-btn icon-edit" onclick="openEditModal('${b.year_month}')" title="Bearbeiten" type="button">✎</button>
          <button class="icon-btn icon-delete" onclick="deleteBudget('${b.year_month}')" title="Löschen" type="button">✕</button>
        </td>
      </tr>
    `;
  }).join('');
}

function openEditModal(yearMonth) {
  const found = budgets.find(b => b.year_month === yearMonth);
  if (!found) return;

  editingYearMonth = yearMonth;
  document.getElementById('editBudgetAmount').value = found.budget_amount ?? 0;
  document.getElementById('editModal').classList.add('active');
}

function closeModal() {
  document.getElementById('editModal').classList.remove('active');
  editingYearMonth = null;
}

async function saveEdit(event) {
  if (event) event.preventDefault();
  if (!editingYearMonth || isLoading) return;

  const amountRaw = document.getElementById('editBudgetAmount').value;
  const amount = parseFloat(amountRaw);

  if (amountRaw === '' || Number.isNaN(amount) || amount < 0) {
    alert('Bitte einen gültigen Betrag eingeben.');
    return;
  }

  isLoading = true;

  try {
    const { error } = await db
      .from('budget_history')
      .update({ budget_amount: amount })
      .eq('report_id', reportId)
      .eq('year_month', editingYearMonth);

    if (error) throw error;

    closeModal();
    await loadBudgets();
  } catch (err) {
    console.error('Fehler beim Aktualisieren:', err);
    alert('Fehler beim Aktualisieren: ' + (err?.message || err));
  } finally {
    isLoading = false;
  }
}

async function deleteBudget(yearMonth) {
  if (isLoading) return;

  const ok = confirm(`Budget ${yearMonth} wirklich löschen?`);
  if (!ok) return;

  isLoading = true;

  try {
    const { error } = await db
      .from('budget_history')
      .delete()
      .eq('report_id', reportId)
      .eq('year_month', yearMonth);

    if (error) throw error;

    await loadBudgets();
  } catch (err) {
    console.error('Fehler beim Löschen:', err);
    alert('Fehler beim Löschen: ' + (err?.message || err));
  } finally {
    isLoading = false;
  }
}

function clearForm(event) {
  if (event) event.preventDefault();

  const now = new Date();
  setYearMonth(String(now.getFullYear()), String(now.getMonth() + 1).padStart(2, '0'));
  document.getElementById('budgetAmount').value = '';
}

function formatCurrency(value) {
  return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(value);
}

// Für inline onclick in der Tabelle
window.openEditModal = openEditModal;
window.deleteBudget = deleteBudget;
